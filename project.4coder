version(2);
project_name = "4coder";

indent_with_tabs = false;
indent_width = 2;
default_tab_width = 2;
indent_clear_blank_lines = false;

patterns = {
 "*.c",
 "*.cpp",
 "*.h",
 "*.m",
 "*.mm",
 "*.bat",
 "*.sh",
 "*.4coder",
 "*.txt",
 "*.frag",
 "*.vert"
};
blacklist_patterns = {
 ".*",
};

load_paths = {
 .win = {
  { .path = ".", .recursive = true, .relative = true, },
 },
 .linux = {
  { .path = ".", .recursive = true, .relative = true, },
 },
 .mac = {
  { .path = ".", .recursive = true, .relative = true, },
 },
};

